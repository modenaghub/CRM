# Copie este arquivo para ".env" (mesma pasta, raiz do projeto) e troque os
# valores abaixo antes de subir em produção. O docker-compose.yml lê este
# arquivo automaticamente se ele existir.
#
#   cp .env.example .env
#
# Se você não criar o ".env", o docker-compose usa os valores padrão
# (bons para teste, não para produção real).

POSTGRES_PASSWORD=troque_esta_senha_do_banco
JWT_ACCESS_SECRET=troque_este_segredo_de_acesso_por_uma_string_aleatoria_longa
JWT_REFRESH_SECRET=troque_este_segredo_de_refresh_por_outra_string_aleatoria_longa

# URL pública do seu CRM (usada para montar o link que fornecedores recebem
# por WhatsApp/e-mail para preencher cotação ou confirmar ordem de compra).
APP_PUBLIC_URL=https://crm.suaempresa.com.br
